import { Notification, NotificationType } from "../../types/notification-ui.slint";
import { TaskUi } from "../task/globals.slint";
import { DocumentUi } from "../document/globals.slint";
import { MenubarData } from "../../globals.slint";

export global NotificationUi {
    in-out property <Notification> selected-notification;
    changed selected-notification => { MenubarData.refresh(); }
    callback dispatch-source-notification(string, string);
    out property <bool> can-open-selected: !selected-notification.resource-id.is-empty
        && (selected-notification.source != "builtin"
        || (!selected-notification.folder-id.is-empty
            && (selected-notification.n-type == NotificationType.new-task
            || selected-notification.n-type == NotificationType.new-document)));
    public function open-selected() {
        if can-open-selected {
            if selected-notification.source != "builtin" {
                dispatch-source-notification(selected-notification.source, selected-notification.id);
            } else if selected-notification.n-type == NotificationType.new-document {
                DocumentUi.open(selected-notification.folder-id, selected-notification.resource-id);
            } else {
                TaskUi.open(selected-notification.folder-id, selected-notification.resource-id);
            }
        }
    }
    public function toggle-selected-read() {
        if !selected-notification.id.is-empty {
            set-read(selected-notification.id, !selected-notification.unread);
        }
    }
    public function unselect() { selected-notification = { }; }
    in-out property <int> unread-count;
    callback opened();
    callback closed();
    callback mark-all-as-read();
    callback set-read(string, bool);
    callback load-more();
    in-out property <float> progress;
    in-out property <color> progress-color: #78aaff;
    in-out property <[Notification]> temp-notifs;
    in-out property <[Notification]> notifications;
}
