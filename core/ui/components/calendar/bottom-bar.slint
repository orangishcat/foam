import { SelectedItemAction } from "../selected-item-action.slint";
import { CalendarUi } from "globals.slint";
import { UiState } from "../../globals.slint";
import { BottomBarFrame } from "../bottom-bar-frame.slint";

export component CalendarBottomBar inherits BottomBarFrame {
    if !CalendarUi.selected-task.folder-id.is-empty: Rectangle {
        HorizontalLayout {
            alignment: center;
            view-item := SelectedItemAction {
                hotkey-name: "V";
                hotkey: @keys(V);
                action-name: "View item";
                action => { CalendarUi.open-selected(); }
            }

            mark-done := SelectedItemAction {
                hotkey-name: "D";
                hotkey: @keys(D);
                action-name: CalendarUi.selected-task.completed ? "Mark as not done" : "Mark as done";
                action => { CalendarUi.toggle-selected-completed(); }
            }

            unselect := SelectedItemAction {
                hotkey-name: "Esc";
                hotkey: @keys(Escape);
                action-name: "Unselect item";
                action => { CalendarUi.unselect(); }
            }
        }
    }
}
