import { ScrollView } from "std-widgets.slint";
import { Row } from "row.slint";
import { FoldersUi } from "../folders/globals.slint";
import { UiState } from "../../globals.slint";
import { FolderTab, ResourceItem } from "../../types/folder-ui.slint";

export component Sidebar inherits Rectangle {
    in property <FolderTab> tab;
    in property <[ResourceItem]> items: tab.parent-resources;
    in property <string> selected-id: tab.folder-id;

    width: 12.5rem;
    background: {
        let c = UiState.theme.colors.background.to-oklch();
        oklch(c.lightness - 0.03, c.chroma, c.hue, c.alpha)
    };
    VerticalLayout {
        padding-left: 0.5rem;
        padding-right: 0.5rem;
        sidebar := ScrollView {
            horizontal-scrollbar-policy: always-off;
            VerticalLayout {
                spacing: 0.125rem;
                padding-top: 1rem;
                padding-bottom: 1rem;

                for item[i] in root.items: Row {
                    width: sidebar.visible-width;
                    item: item;
                    double-click: false;
                    selected: item.folder-id == root.tab.folder-id
                        && (item.kind == "folder" || item.id == root.selected-id);
                }
            }
        }
    }
}
