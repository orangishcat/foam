import { ScrollView } from "std-widgets.slint";
import { Screen } from "../../types/screen.slint";
import { Row } from "row.slint";
import { ResourceItem, FolderTab } from "../../types/folder-ui.slint";
import {
    Breadcrumb,
} from "breadcrumb.slint";
import { Sidebar } from "sidebar.slint";
import { UiState, MenubarData } from "../../globals.slint";
import { FoldersUi } from "../folders/globals.slint";
import { ResourceUi } from "globals.slint";
import { TopBar } from "top-bar.slint";
import { CreateMaterialDialog } from "create-material.slint";
import { BottomBarFrame } from "../bottom-bar-frame.slint";

import { ResourcesBottomBar } from "bottom-bar.slint";

export global ResourcesMenu {
    in-out property <int> selected-index: -1;
    private property <FolderTab> tab: FoldersUi.tabs[FoldersUi.active-tab];
    changed tab => { selected-index = -1; }
    changed selected-index => { MenubarData.refresh(); }
    private property <bool> has-selection: FoldersUi.active-tab >= 0
        && FoldersUi.active-tab < FoldersUi.tabs.length
        && selected-index >= 0 && selected-index < tab.resources.length;
    public function activate(index: int) {
        if index == 0 { FoldersUi.close-tab(FoldersUi.active-tab); }
        else if has-selection {
            if index == 1 { ResourceUi.open(tab.resources[selected-index]); }
            else if index == 2 { ResourceUi.open-in-browser(tab.resources[selected-index]); }
            else if index == 3 { selected-index = -1; }
        }
    }
}

export component Resources inherits Rectangle {
    in property <length> sidebar-width: 0rem;
    in property <bool> custom-titlebar: false;
    in property <FolderTab> tab;

    VerticalLayout {
        spacing: 0rem;
        TopBar {
            tab: root.tab;
            custom-titlebar: root.custom-titlebar;
        }

        Rectangle {
            vertical-stretch: 1;
            Rectangle {
                x: root.sidebar-width;
                width: parent.width - root.sidebar-width;
                height: parent.height;
                HorizontalLayout {
                    spacing: 0rem;
                    Sidebar {
                        tab <=> root.tab;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        VerticalLayout {
                            padding-left: 1rem;
                            padding-right: 1rem;
                            list := ScrollView {
                                horizontal-scrollbar-policy: always-off;
                                VerticalLayout {
                                    padding-top: 1rem;
                                    padding-bottom: 1rem;
                                    for item[i] in root.tab.resources: VerticalLayout {
                                        padding-bottom: 0.25rem;
                                        Row {
                                            width: list.visible-width;
                                            item: item;
                                            selected-index <=> ResourcesMenu.selected-index;
                                            row-index: i;
                                        }

                                        if i < root.tab.resources.length - 1: Rectangle {
                                            border-width: 0.0625rem;
                                            height: 0.0625rem;
                                            border-color: UiState.theme.colors.elevate-2;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        ResourcesBottomBar {
            tab: root.tab;
            selected-index <=> ResourcesMenu.selected-index;
        }

        CreateMaterialDialog { }
    }
}
