export enum NotificationType { new_task, new_document, new_link, unknown }

export struct Notification {
    id: string,
    unread: bool,
    title: string,
    subtitle: string,
    n_type: NotificationType,
    icon: string,
    icon_color: color,
    folder: string,
    folder_id: string,
    resource_id: string,
    // 'builtin' | 'plugin:<id>' attribution, shown as a badge when not builtin
    source: string
}
