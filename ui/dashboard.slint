import { HorizontalBox, VerticalBox, ScrollView } from "std-widgets.slint";
import { Theme } from "palette.slint";
import { AssignmentCol } from "types/assignment.slint";

export component Dashboard inherits Rectangle {
    background: Theme.dark.background-800;

    in-out property <[AssignmentCol]> assignment-view;

    HorizontalBox {
        for col in assignment-view: VerticalBox {
            alignment: start;

            Text {
                text: col.title;
                color: Theme.dark.text-400;
            }

            ScrollView {
                preferred-width: 320px;
                preferred-height: 540px;
                viewport-width: self.visible-width;
                viewport-height: max(self.visible-height, assignments.preferred-height);
                horizontal-scrollbar-policy: always-off;
                assignments := VerticalBox {
                    alignment: start;

                    for assignment in col.assignments: Rectangle {
                        background: col.color;
                        border-radius: 5px;
                        min-height: 40px;
                        max-height: 120px;
                        // Text measurements include font size, weight, and wrapping.
                        preferred-height: title.preferred-height + course.preferred-height
                            + content.padding-top + content.padding-bottom + 16px;
                        clip: true;

                        content := VerticalBox {
                            spacing: 2px;
                            title := Text {
                                text: assignment.title;
                                font-weight: 700;
                                wrap: word-wrap;
                            }

                            course := Text {
                                color: Theme.dark.text-400;
                                text: assignment.course_name;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}
