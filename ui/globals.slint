import { Theme, ColorPalette } from "palette.slint";
import { Screen } from "types/screen.slint";
import { DashboardUi } from "components/dashboard/globals.slint";
import { NotificationUi } from "components/notifications/globals.slint";
import { CoursesUi } from "components/courses/globals.slint";
import { AssignmentUi } from "components/assignment/globals.slint";
import { DocumentUi } from "components/document/globals.slint";
import { MaterialUi } from "components/materials/globals.slint";
import { SettingsUi } from "components/settings/globals.slint";
import { SearchUi, SearchResult } from "components/search/globals.slint";


export global WindowChrome {
    // whether the traffic lights are slint rendered (macos false, windows and linux true)
    in-out property <bool> client-side: false;
    callback toggle-maximized();
}

export global UiState {
    in-out property <int> font-size;
    in-out property <bool> shift-held: false;
    in-out property <string> shortcut-modifier: "Ctrl";
    in-out property <int> focused-sidebar-item: -1;
    in-out property <Screen> screen: Screen.dashboard;
    in-out property <ColorPalette> theme: Theme.current;
    out property <length> top-bar-height: font-size * 2px;
    out property <length> bottom-bar-height: font-size * 1.75px;
}

export global OnboardingUi {
    in-out property <int> step: 0;
    in-out property <string> subdomain;
    in-out property <string> api-key;
    in-out property <string> api-secret;
    in-out property <string> calendar-url;
    in-out property <string> error;
    in-out property <bool> busy: false;
    callback previous();
    callback next();
    callback skip-api();
}

export { DashboardUi } from "components/dashboard/globals.slint";
export { NotificationUi } from "components/notifications/globals.slint";
export { CoursesUi } from "components/courses/globals.slint";
export { AssignmentUi } from "components/assignment/globals.slint";
export { DocumentUi } from "components/document/globals.slint";
export { MaterialUi } from "components/materials/globals.slint";
export { SettingsUi } from "components/settings/globals.slint";
export { SearchUi, SearchResult } from "components/search/globals.slint";
