import { Screen } from "types/screen.slint";
import { Theme, ColorPalette } from "palette.slint";

export global WindowChrome {
    // whether the traffic lights are slint rendered (macos false, windows and linux true)
    in-out property <bool> client-side: false;
    callback toggle-maximized();
}

export global UiState {
    in-out property <int> font-size;
    in-out property <bool> shift-held: false;
    in-out property <string> shortcut-modifier: "Ctrl";
    in-out property <int> focused-sidebar-item: -1;
    in-out property <Screen> screen: Screen.dashboard;
    in-out property <ColorPalette> theme: Theme.dark;
    out property <length> top-bar-height: font-size * 2px;
    out property <length> bottom-bar-height: font-size * 1.75px;
}
