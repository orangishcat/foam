import { VerticalBox } from "std-widgets.slint";
import { Theme } from "palette.slint";
import { Screen } from "screen/screens.slint";

component NavigationItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;

    in-out property <Screen> screen;
    in property <Screen> change-to;

    height: 44px;
    border-radius: 6px;
    background: screen == change-to ? Theme.dark.background-700 : (touch.has-hover ? Theme.dark.background-600 : transparent);

    touch := TouchArea {
        clicked => {
            screen = change-to;
        }
    }

    Image {
        source: icon;
        colorize: Theme.dark.text-200;
    }
    // Text {
    //     text: root.label;
    //     color: selected ? Theme.dark.text-50 : Theme.dark.text-200;
    //     font-size: 16px;
    //     vertical-alignment: center;
    //     x: 16px;
    // }
}

export component Sidebar inherits Rectangle {
    in property <bool> minimized: true;
    in-out property <Screen> screen: dashboard;

    width: minimized ? 60px : 240px;
    background: Theme.dark.background-900;

    VerticalBox {
        padding: 8px;
        spacing: 10px;

        Rectangle {
            height: 0px;
        }

        NavigationItem {
            label: "Dashboard";
            icon: @image-url("icons/calendar-days.svg");
            screen <=> root.screen;
            change-to: dashboard;
        }

        NavigationItem {
            label: "Notifications";
            icon: @image-url("icons/bell.svg");
            screen <=> root.screen;
            change-to: notifs;
        }

        Rectangle {
            vertical-stretch: 1;
        }

        NavigationItem {
            label: "Settings";
            icon: @image-url("icons/settings.svg");
            screen <=> root.screen;
            change-to: settings;
        }
    }
}
