export struct ColorPalette {
    text-50: color,
    text-100: color,
    text-200: color,
    text-300: color,
    text-400: color,
    text-500: color,
    text-600: color,
    text-700: color,
    text-800: color,
    text-900: color,
    text-950: color,
    background-50: color,
    background-100: color,
    background-200: color,
    background-300: color,
    background-400: color,
    background-500: color,
    background-600: color,
    background-700: color,
    background-750: color,
    background-800: color,
    background-850: color,
    background-900: color,
    background-950: color,
    primary-50: color,
    primary-100: color,
    primary-200: color,
    primary-300: color,
    primary-400: color,
    primary-500: color,
    primary-600: color,
    primary-700: color,
    primary-800: color,
    primary-900: color,
    primary-950: color,
    secondary-50: color,
    secondary-100: color,
    secondary-200: color,
    secondary-300: color,
    secondary-400: color,
    secondary-500: color,
    secondary-600: color,
    secondary-700: color,
    secondary-800: color,
    secondary-900: color,
    secondary-950: color,
    progress-100: color,
    progress-200: color,
    progress-300: color,
    progress-400: color,
    progress-500: color,
    progress-600: color,
    progress-700: color,
    progress-800: color,
    progress-900: color,
}

export global Theme {
    in-out property <color> text: oklch(61.62%, 0.005, 47.34deg);
    in-out property <color> background: oklch(59.40%, 0.025, 42.45deg);
    in-out property <color> primary: oklch(61.81%, 0.085, 56.07deg);
    in-out property <color> secondary: oklch(54.73%, 0.110, 263.10deg);
    in-out property <color> progress-red: oklch(55.447%, 0.08888, 29.23deg);
    in-out property <color> progress-yellow: oklch(55.447%, 0.08888, 91.28deg);
    in-out property <color> progress-green: oklch(55.447%, 0.08888, 153.34deg);

    callback reset();

    public pure function lightness(family: int, step: float) -> float {
        family == 0
            ? (step <= 0.05 ? 0.9610
            : step <= 0.15 ? 0.9231
            : step <= 0.25 ? 0.8449
            : step <= 0.35 ? 0.7678
            : step <= 0.45 ? 0.6917
            : step <= 0.55 ? 0.6162
            : step <= 0.65 ? 0.5261
            : step <= 0.75 ? 0.4300
            : step <= 0.85 ? 0.3283
            : step <= 0.95 ? 0.2191
            : 0.1588)
            : family == 2
            ? (step <= 0.05 ? 0.9620
            : step <= 0.15 ? 0.9254
            : step <= 0.25 ? 0.8493
            : step <= 0.35 ? 0.7729
            : step <= 0.45 ? 0.6961
            : step <= 0.55 ? 0.6181
            : step <= 0.65 ? 0.5273
            : step <= 0.75 ? 0.4312
            : step <= 0.85 ? 0.3295
            : step <= 0.95 ? 0.2204
            : 0.1594)
            : family == 3
            ? (step <= 0.05 ? 0.9568
            : step <= 0.15 ? 0.9121
            : step <= 0.25 ? 0.8221
            : step <= 0.35 ? 0.7331
            : step <= 0.45 ? 0.6405
            : step <= 0.55 ? 0.5473
            : step <= 0.65 ? 0.4681
            : step <= 0.75 ? 0.3854
            : step <= 0.85 ? 0.2954
            : step <= 0.95 ? 0.2010
            : 0.1498)
            : (step <= 0.05 ? 0.9624
            : step <= 0.15 ? 0.9217
            : step <= 0.25 ? 0.8438
            : step <= 0.35 ? 0.7620
            : step <= 0.45 ? 0.6803
            : step <= 0.55 ? 0.5940
            : step <= 0.65 ? 0.5077
            : step <= 0.71 ? 0.4152
            : step <= 0.74 ? 0.3452  // background-750 @ 0.72
            : step <= 0.82 ? 0.3196
            : step <= 0.87 ? 0.2753
            : step <= 0.95 ? 0.2133
            : 0.1564)
    }

    public pure function chroma(family: int, step: float, basechroma: float) -> float {
        let ramp = (family == 0
            ? (step <= 0.05 ? 0.005 : step <= 0.15 ? 0.005 : step <= 0.25 ? 0.005
            : step <= 0.35 ? 0.005 : step <= 0.45 ? 0.005 : step <= 0.55 ? 0.005
            : step <= 0.65 ? 0.005 : step <= 0.75 ? 0.005 : step <= 0.85 ? 0.005
            : step <= 0.95 ? 0.005 : 0.005)
            : family == 1
            ? (step <= 0.05 ? 0.003 : step <= 0.15 ? 0.005 : step <= 0.25 ? 0.009
            : step <= 0.35 ? 0.014 : step <= 0.45 ? 0.019 : step <= 0.55 ? 0.025
            : step <= 0.65 ? 0.020 : step <= 0.71 ? 0.016 : step <= 0.74 ? 0.013
            : step <= 0.82 ? 0.011 : step <= 0.87 ? 0.011 : step <= 0.95 ? 0.007
            : 0.004)
            : family == 2
            ? (step <= 0.05 ? 0.008 : step <= 0.15 ? 0.016 : step <= 0.25 ? 0.031
            : step <= 0.35 ? 0.049 : step <= 0.45 ? 0.068 : step <= 0.55 ? 0.085
            : step <= 0.65 ? 0.072 : step <= 0.75 ? 0.056 : step <= 0.85 ? 0.040
            : step <= 0.95 ? 0.023 : 0.012)
            : (step <= 0.05 ? 0.009 : step <= 0.15 ? 0.019 : step <= 0.25 ? 0.041
            : step <= 0.35 ? 0.061 : step <= 0.45 ? 0.086 : step <= 0.55 ? 0.110
            : step <= 0.65 ? 0.092 : step <= 0.75 ? 0.072 : step <= 0.85 ? 0.053
            : step <= 0.95 ? 0.028 : 0.016));
        let reference = family == 0 ? 0.005 : family == 1 ? 0.025 : family == 2 ? 0.085 : 0.110;
        ramp * basechroma / reference
    }

    // step: 0..1 mapping shade 50..950, family: 0 text, 1 background, 2 primary, 3 secondary
    public pure function shade(base: color, family: int, step: float) -> color {
        let c = base.to-oklch();
        oklch(self.lightness(family, step), self.chroma(family, step, c.chroma), c.hue, c.alpha)
    }

    // step: 0..1 mapping progress shade 100..900, interpolating between the
    // three anchor points (red -> yellow -> green)
    public pure function progress-step(red: color, yellow: color, green: color, step: float) -> color {
        let a = step <= 0.5 ? red.to-oklch() : yellow.to-oklch();
        let b = step <= 0.5 ? yellow.to-oklch() : green.to-oklch();
        let t = step <= 0.5 ? step / 0.5 : (step - 0.5) / 0.5;
        oklch(
            a.lightness + (b.lightness - a.lightness) * t,
            a.chroma + (b.chroma - a.chroma) * t,
            a.hue + (b.hue - a.hue) * t,
            a.alpha,
        )
    }

    reset() => {
        self.text = oklch(61.62%, 0.005, 47.34deg);
        self.background = oklch(59.40%, 0.025, 42.45deg);
        self.primary = oklch(61.81%, 0.085, 56.07deg);
        self.secondary = oklch(54.73%, 0.110, 263.10deg);
        self.progress-red = oklch(55.447%, 0.08888, 29.23deg);
        self.progress-yellow = oklch(55.447%, 0.08888, 91.28deg);
        self.progress-green = oklch(55.447%, 0.08888, 153.34deg);
    }

    out property <ColorPalette> current: {
        text-50: root.shade(root.text, 0, 0.0),
        text-100: root.shade(root.text, 0, 0.1),
        text-200: root.shade(root.text, 0, 0.2),
        text-300: root.shade(root.text, 0, 0.3),
        text-400: root.shade(root.text, 0, 0.4),
        text-500: root.shade(root.text, 0, 0.5),
        text-600: root.shade(root.text, 0, 0.6),
        text-700: root.shade(root.text, 0, 0.7),
        text-800: root.shade(root.text, 0, 0.8),
        text-900: root.shade(root.text, 0, 0.9),
        text-950: root.shade(root.text, 0, 1.0),
        background-50: root.shade(root.background, 1, 0.0),
        background-100: root.shade(root.background, 1, 0.1),
        background-200: root.shade(root.background, 1, 0.2),
        background-300: root.shade(root.background, 1, 0.3),
        background-400: root.shade(root.background, 1, 0.4),
        background-500: root.shade(root.background, 1, 0.5),
        background-600: root.shade(root.background, 1, 0.6),
        background-700: root.shade(root.background, 1, 0.7),
        background-750: root.shade(root.background, 1, 0.72),
        background-800: root.shade(root.background, 1, 0.8),
        background-850: root.shade(root.background, 1, 0.85),
        background-900: root.shade(root.background, 1, 0.9),
        background-950: root.shade(root.background, 1, 1.0),
        primary-50: root.shade(root.primary, 2, 0.0),
        primary-100: root.shade(root.primary, 2, 0.1),
        primary-200: root.shade(root.primary, 2, 0.2),
        primary-300: root.shade(root.primary, 2, 0.3),
        primary-400: root.shade(root.primary, 2, 0.4),
        primary-500: root.shade(root.primary, 2, 0.5),
        primary-600: root.shade(root.primary, 2, 0.6),
        primary-700: root.shade(root.primary, 2, 0.7),
        primary-800: root.shade(root.primary, 2, 0.8),
        primary-900: root.shade(root.primary, 2, 0.9),
        primary-950: root.shade(root.primary, 2, 1.0),
        secondary-50: root.shade(root.secondary, 3, 0.0),
        secondary-100: root.shade(root.secondary, 3, 0.1),
        secondary-200: root.shade(root.secondary, 3, 0.2),
        secondary-300: root.shade(root.secondary, 3, 0.3),
        secondary-400: root.shade(root.secondary, 3, 0.4),
        secondary-500: root.shade(root.secondary, 3, 0.5),
        secondary-600: root.shade(root.secondary, 3, 0.6),
        secondary-700: root.shade(root.secondary, 3, 0.7),
        secondary-800: root.shade(root.secondary, 3, 0.8),
        secondary-900: root.shade(root.secondary, 3, 0.9),
        secondary-950: root.shade(root.secondary, 3, 1.0),
        progress-100: root.progress-step(root.progress-red, root.progress-yellow, root.progress-green, 0.0),
        progress-200: root.progress-step(root.progress-red, root.progress-yellow, root.progress-green, 0.2),
        progress-300: root.progress-step(root.progress-red, root.progress-yellow, root.progress-green, 0.3),
        progress-400: root.progress-step(root.progress-red, root.progress-yellow, root.progress-green, 0.4),
        progress-500: root.progress-step(root.progress-red, root.progress-yellow, root.progress-green, 0.5),
        progress-600: root.progress-step(root.progress-red, root.progress-yellow, root.progress-green, 0.6),
        progress-700: root.progress-step(root.progress-red, root.progress-yellow, root.progress-green, 0.7),
        progress-800: root.progress-step(root.progress-red, root.progress-yellow, root.progress-green, 0.8),
        progress-900: root.progress-step(root.progress-red, root.progress-yellow, root.progress-green, 0.9),
    };
}
