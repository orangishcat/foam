import { ScrollView, VerticalBox } from "std-widgets.slint";
import { AssignmentUi, CoursesUi, UiState } from "../globals.slint";
import { CourseTab } from "../types/course-ui.slint";
import { MaterialSidebar } from "../components/course-sidebar.slint";
import { MaterialBreadcrumb } from "../components/material-breadcrumb.slint";
import { Screen } from "screens.slint";
import { MaterialBottomBar } from "../components/material-bottom-bar.slint";

export component AssignmentView inherits Rectangle {
    in property <CourseTab> tab;
    background: UiState.theme.background-800;

    VerticalLayout {
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;
            MaterialSidebar {
                tab: root.tab;
                items: root.tab.materials;
                selected-id: AssignmentUi.assignment.id;
            }

            Rectangle {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 16px;
                    spacing: 14px;

                    VerticalLayout {
                        padding-left: 2px;
                        padding-top: 8px;
                        spacing: 16px;

                        Text {
                            text: AssignmentUi.assignment.title;
                            font-size: 24px;
                            font-weight: 700;
                            wrap: word-wrap;
                            color: UiState.theme.text-50;
                        }

                        if !AssignmentUi.error.is-empty: Text {
                            text: AssignmentUi.error;
                            color: UiState.theme.primary-300;
                            font-size: 18px;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            padding-left: 2px;
                            Text {
                                text: AssignmentUi.assignment.due + " • ID " + AssignmentUi.assignment.id;
                                color: UiState.theme.text-200;
                                font-size: 14px;
                                wrap: word-wrap;
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                            }

                            Text {
                                text: "Grade: " + AssignmentUi.assignment.grade;
                                color: UiState.theme.text-200;
                                font-size: 14px;
                                wrap: word-wrap;
                            }
                        }
                    }

                    ScrollView {
                        horizontal-scrollbar-policy: always-off;
                        VerticalLayout {
                            alignment: start;
                            spacing: 12px;
                            padding-right: 12px;
                            if !AssignmentUi.assignment.description.is-empty: VerticalLayout {
                                Rectangle {
                                    background: UiState.theme.background-750;
                                    border-radius: 8px;

                                    VerticalLayout {
                                        padding: 12px;
                                        Text {
                                            text: AssignmentUi.assignment.description;
                                            color: UiState.theme.text-100;
                                            line-height-factor: 1.25;
                                            font-size: 16px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            Rectangle {
                width: 200px;
                background: {
                    let c = UiState.theme.background-800.to-oklch();
                    oklch(c.lightness - 0.02, c.chroma, c.hue, c.alpha)
                };
                VerticalLayout {
                    spacing: 24px;
                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        Text {
                            text: "Attachments";
                            font-size: 18px;
                            font-weight: 700;
                            color: UiState.theme.text-50;
                        }

                        if AssignmentUi.assignment.attachments.length > 0: VerticalLayout {
                            spacing: 6px;

                            for file in AssignmentUi.assignment.attachments: Rectangle {
                                background: UiState.theme.background-750;
                                border-radius: 5px;
                                VerticalLayout {
                                    padding: 8px;
                                    Text {
                                        text: file.title;
                                        color: UiState.theme.text-100;
                                        wrap: word-wrap;
                                    }

                                    if !file.details.is-empty: Text {
                                        text: file.details;
                                        color: UiState.theme.text-400;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }

                        if AssignmentUi.assignment.attachments.length == 0: Text {
                            text: "No attachments";
                            color: UiState.theme.text-400;
                            font-size: 14px;
                        }
                    }

                    VerticalLayout {
                        padding: 16px;
                        spacing: 12px;
                        Text {
                            text: "Submissions";
                            font-size: 18px;
                            font-weight: 700;
                            color: UiState.theme.text-50;
                        }

                        if AssignmentUi.assignment.submissions.length == 0: Text {
                            text: "No submissions yet";
                            color: UiState.theme.text-400;
                            font-size: 14px;
                        }

                        ScrollView {
                            horizontal-scrollbar-policy: always-off;
                            VerticalLayout {
                                alignment: start;
                                spacing: 10px;
                                padding-right: 8px;
                                if AssignmentUi.assignment.submissions.length > 0: VerticalLayout {
                                    spacing: 10px;

                                    for submission in AssignmentUi.assignment.submissions: Rectangle {
                                        background: UiState.theme.background-750;
                                        border-radius: 6px;
                                        height: content.preferred-height + 20px;
                                        content := VerticalLayout {
                                            padding: 10px;
                                            Text {
                                                text: "Revision " + submission.id;
                                                color: UiState.theme.text-100;
                                                font-size: 14px;
                                                wrap: word-wrap;
                                            }

                                            Text {
                                                text: submission.created-at + " · " + submission.status;
                                                color: UiState.theme.text-300;
                                                wrap: word-wrap;
                                            }

                                            if !submission.body.is-empty: Text {
                                                text: submission.body;
                                                color: UiState.theme.text-100;
                                                wrap: word-wrap;
                                            }
                                            for file in submission.files: VerticalLayout {
                                                Text {
                                                    text: file.title;
                                                    color: UiState.theme.text-100;
                                                    wrap: word-wrap;
                                                }

                                                if !file.details.is-empty: Text {
                                                    text: file.details;
                                                    color: UiState.theme.text-400;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        MaterialBottomBar {
            tab <=> root.tab;
        }
    }
}
