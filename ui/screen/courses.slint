import { ScrollView } from "std-widgets.slint";
import { UiState, CoursesUi } from "../globals.slint";
import { CourseItem } from "../types/course-ui.slint";

export component Courses inherits Rectangle {
    private property <int> drag-from: -1;
    private property <int> drag-to: -1;
    private property <length> drag-pointer-y: 0px;
    private property <CourseItem> dragged-course;

    list := ScrollView {
        x: 32px;
        y: 32px;
        width: parent.width - 64px;
        height: parent.height - 64px;
        horizontal-scrollbar-policy: always-off;
        mouse-drag-pan-enabled: false;

        VerticalLayout {
            spacing: 0px;
            for course[i] in CoursesUi.courses: Rectangle {
                visible: !course.hidden;
                width: list.visible-width;
                height: course.hidden ? 0px : 88px;
                background: transparent;

                course-touch := TouchArea {
                    clicked => {
                        CoursesUi.open(course.id, "", "course");
                    }
                    mouse-cursor: pointer;
                    Rectangle {
                        y: root.drag-from >= 0 && i > root.drag-from && i <= root.drag-to ? -82px
                            : root.drag-from >= 0 && i < root.drag-from && i >= root.drag-to ? 82px
                            : 0px;
                        width: parent.width;
                        height: 74px;
                        border-radius: 8px;
                        border-width: 1px;
                        border-color: UiState.theme.background-500;
                        background: course-touch.has-hover ? UiState.theme.background-600 : UiState.theme.background-700;
                        opacity: root.drag-from == i ? 0 : 1;

                        HorizontalLayout {
                            padding: 16px;
                            spacing: 16px;

                            VerticalLayout {
                                spacing: 4px;
                                Text {
                                    text: course.title;
                                    font-size: 18px;
                                    font-weight: 700;
                                    color: UiState.theme.text-50;
                                    overflow: elide;
                                }

                                Text {
                                    text: course.section + "  ·  " + course.code;
                                    color: UiState.theme.text-200;
                                    overflow: elide;
                                }
                            }

                            HorizontalLayout {
                                spacing: 16px;
                                visible: course-touch.has-hover;
                                drag-layout := Rectangle {
                                    width: 32px;
                                    border-radius: 10px;
                                    background: {
                                        let color = UiState.theme.background-400.to-oklch();
                                        drag-touch.has-hover ? oklch(color.lightness, color.chroma, color.hue, 0.6) : transparent
                                    };
                                    drag-touch := TouchArea {
                                        mouse-cursor: grab;
                                        Image {
                                            source: @image-url("../icons/grip-horizontal.svg");
                                            colorize: UiState.theme.background-400;
                                            vertical-alignment: center;
                                            horizontal-alignment: center;
                                        }

                                        drag-area := DragArea {
                                            width: parent.width;
                                            height: parent.height;
                                            data: CoursesUi.drag-data(i);
                                            allow-move: true;
                                            drag-finished(_action) => {
                                                root.drag-from = -1;
                                                root.drag-to = -1;
                                            }
                                        }
                                    }
                                }

                                hide-rectangle := Rectangle {
                                    width: 32px;
                                    border-radius: 10px;
                                    background: {
                                        let color = UiState.theme.background-400.to-oklch();
                                        x-touch.has-hover ? oklch(color.lightness, color.chroma, color.hue, 0.6) : transparent
                                    };

                                    x-touch := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            CoursesUi.hide(course.id);
                                        }

                                        Image {
                                            source: @image-url("../icons/x.svg");
                                            colorize: UiState.theme.background-400;
                                            vertical-alignment: center;
                                            horizontal-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    drop-area := DropArea {
        x: list.x;
        y: list.y;
        width: list.visible-width;
        height: list.height;
        can-drop(event) => {
            let source = CoursesUi.drag-index(event.data);
            if (source < 0 || source >= CoursesUi.courses.length) {
                return DragAction.none;
            }
            root.drag-from = source;
            root.dragged-course = CoursesUi.courses[source];
            root.drag-pointer-y = event.position.y;
            root.drag-to = Math.max(0, Math.min(CoursesUi.courses.length - 1,
        Math.round((event.position.y - list.viewport-y - 37px) / 82px)));
            return DragAction.move;
        }
        dropped(event) => {
            if (root.drag-from >= 0) {
                CoursesUi.reorder(root.drag-from, root.drag-to);
            }
            root.drag-from = -1;
            root.drag-to = -1;
            return DragAction.move;
        }
    }

    Rectangle {
        visible: root.drag-from >= 0;
        x: list.x;
        y: list.y + root.drag-pointer-y - 37px;
        width: list.visible-width;
        height: 74px;
        border-radius: 8px;
        border-width: 1px;
        border-color: UiState.theme.background-500;
        background: UiState.theme.background-700;
        opacity: 0.65;

        HorizontalLayout {
            padding: 16px;
            spacing: 16px;

            VerticalLayout {
                spacing: 4px;
                Text {
                    text: root.dragged-course.title;
                    font-size: 18px;
                    font-weight: 700;
                    color: UiState.theme.text-50;
                    overflow: elide;
                }

                Text {
                    text: root.dragged-course.section + "  ·  " + root.dragged-course.code;
                    color: UiState.theme.text-200;
                    overflow: elide;
                }
            }
        }
    }
}
