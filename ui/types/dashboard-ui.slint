export struct Assignment {
    id: string,
    title: string,
    course-id: string,
    course-name: string,
    done: bool,
    date: string,
    time: string,
    overdue: bool,
    is-event: bool,
    is-schoology: bool,
}

export struct AssignmentCol {
    title: string,
    assignments: [Assignment],
}
