export enum NotificationType { new_assignment, new_document, new_grade, new_link, unknown }

export struct Notification {
    title: string,
    n_type: NotificationType,
    icon_color: color,
    course: string,
    course_id: string
}

export struct NotificationUi {
    progress: float,
    temp-notifs: [Notification],
    notifications: [Notification],
}
