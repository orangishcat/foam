import { HorizontalBox } from "std-widgets.slint";
import { Dashboard } from "components/dashboard/dashboard.slint";
import { DashboardBottomBar } from "components/dashboard/bottom-bar.slint";
import { Screen } from "types/screen.slint";
import { Courses } from "components/courses/courses.slint";
import { CoursesBottomBar } from "components/courses/bottom-bar.slint";
import { Materials } from "components/materials/materials.slint";
import { Sidebar } from "components/sidebar.slint";
import { UiState, CoursesUi } from "globals.slint";
export {
    UiState,
    DashboardUi,
    NotificationUi,
    CoursesUi,
    AssignmentUi,
} from "globals.slint";
import "fonts/MozillaText.ttf";
import { Notifications } from "components/notifications/notifications.slint";
import { AssignmentView } from "components/assignment/assignment-view.slint";
import { BottomBar } from "components/materials/bottom-bar.slint";

export component AppWindow inherits Window {
    title: "foam";
    default-font-family: "Mozilla Text";
    preferred-width: 1100px;
    preferred-height: 700px;

    background: UiState.theme.background-800;
    in property <bool> custom-titlebar: false;
    private property <color> bar-background: {
        let c = UiState.theme.background-900.to-oklch();
        oklch(c.lightness + 0.03, c.chroma, c.hue, c.alpha)
    };
    private property <length> bar-height: 32px;

    VerticalLayout {
        spacing: 0px;
        if root.custom-titlebar: Rectangle {
            height: root.bar-height - 1px;
            background: root.bar-background;
            Text {
                x: 80px;
                y: 7px;
                text: root.title;
                color: UiState.theme.text-100;
                vertical-alignment: center;
                horizontal-alignment: left;
            }
        }

        HorizontalBox {
            vertical-stretch: 1;
            padding: 0px;
            spacing: 0px;

            Sidebar { }

            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                if UiState.screen == Screen.dashboard: Dashboard {
                    width: parent.width;
                    height: parent.height;
                }

                if UiState.screen == Screen.notifs: Notifications {
                    width: parent.width;
                    height: parent.height;
                }

                if UiState.screen == Screen.courses: Courses {
                    width: parent.width;
                    height: parent.height;
                }
                for tab[index] in CoursesUi.tabs: AssignmentView {
                    tab: tab;
                    visible: UiState.screen == Screen.assignment && CoursesUi.active-tab == index;
                    width: parent.width;
                    height: parent.height;
                }
                for tab[index] in CoursesUi.tabs: Materials {
                    tab: tab;
                    visible: UiState.screen == Screen.materials && CoursesUi.active-tab == index;
                    width: parent.width;
                    height: parent.height;
                }
            }
        }

        Rectangle {
            height: root.bar-height;
            background: root.bar-background;

            if UiState.screen == Screen.dashboard: DashboardBottomBar {
                width: parent.width;
                height: parent.height;
            }
            if UiState.screen == Screen.courses: CoursesBottomBar {
                width: parent.width;
                height: parent.height;
            }
            for tab[index] in CoursesUi.tabs: BottomBar {
                tab: tab;
                visible: (UiState.screen == Screen.materials || UiState.screen == Screen.assignment)
                    && CoursesUi.active-tab == index;
                width: parent.width;
                height: parent.height;
            }
        }
    }
}
