import { HorizontalBox } from "std-widgets.slint";
import { Dashboard } from "dashboard.slint";
import { Theme } from "palette.slint";
import { Sidebar } from "sidebar.slint";
import "./fonts/MozillaText.ttf";

export component AppWindow inherits Window {
    title: "Foam";

    default-font-family: "Mozilla Text";
    preferred-width: 1200px;
    preferred-height: 800px;

    in-out property <color> text-color: Theme.dark.text-50;
    in-out property <color> background-color: Theme.dark.background-800;
    in-out property <color> primary-color: Theme.dark.primary-500;

    background: root.background-color;

    HorizontalBox {
        padding: 0px;
        spacing: 0px;

        Sidebar { }

        Dashboard {
            horizontal-stretch: 1;
        }
    }
}
