import { Dashboard, DashboardMenu } from "components/dashboard/dashboard.slint";
import { SchoologyOnboarding } from "components/onboarding.slint";
import {
    AttachmentDialog,
    AttachmentMenu,
} from "components/assignment/attachment-window.slint";
export { AttachmentMenu } from "components/assignment/attachment-window.slint";
import { Screen } from "types/screen.slint";
import { Courses, CoursesMenu } from "components/courses/courses.slint";
import { Materials, MaterialsMenu } from "components/materials/materials.slint";
import { Sidebar } from "components/sidebar.slint";
import { WindowControls } from "components/window-controls.slint";
import { Settings } from "components/settings/settings.slint";
import { DocumentView } from "components/document/document-view.slint";
import { UiState, CoursesUi, DashboardUi, NotificationUi, WindowChrome } from "globals.slint";
export {
    WindowChrome,
    UiState,
    OnboardingUi,
    SettingsUi,
    DashboardUi,
    NotificationUi,
    CoursesUi,
    AssignmentUi,
    DocumentUi,
    SearchUi,
    SearchResult,
} from "globals.slint";
import "fonts/MozillaText.ttf";
import {
    Notifications,
    NotificationsMenu,
} from "components/notifications/notifications.slint";
import {
    AssignmentView,
    AssignmentMenu,
} from "components/assignment/assignment-view.slint";
import { Search } from "components/search/search.slint";

export component AppWindow inherits Window {
    title: "foam";
    default-font-family: "Mozilla Text";
    default-font-size: UiState.font-size;
    preferred-width: 68.75rem;
    preferred-height: 43.75rem;
    no-frame: WindowChrome.client-side;
    resize-border-width: WindowChrome.client-side && !root.maximized && !root.full-screen ? 5px : 0px;

    background: UiState.theme.background-800;
    in property <bool> custom-titlebar: false;
    in property <bool> window-active: true;
    in-out property <int> sidebar-focus-request: -1;
    private property <bool> notifications-visible: UiState.screen == Screen.notifs;
    changed notifications-visible => {
        if self.notifications-visible { NotificationUi.opened(); }
        else { NotificationUi.closed(); }
    }
    callback screen-changed();
    private property <Screen> active-screen: UiState.screen;
    changed active-screen => { root.screen-changed(); }
    callback navigate-sidebar(int);
    out property <length> onboarding-x: onboarding.viewer-x;
    out property <length> onboarding-y: onboarding.viewer-y;
    out property <length> onboarding-width: onboarding.viewer-width;
    out property <length> onboarding-height: onboarding.viewer-height;
    callback update-onboarding-webview();
    callback edit-webview(int);
    changed onboarding-x => { root.update-onboarding-webview(); }
    changed onboarding-y => { root.update-onboarding-webview(); }
    changed onboarding-width => { root.update-onboarding-webview(); }
    changed onboarding-height => { root.update-onboarding-webview(); }
    callback step-sidebar(int);
    out property <length> attachment-x: attachment.viewer-x;
    out property <length> attachment-y: attachment.viewer-y;
    out property <length> attachment-width: attachment.viewer-width;
    out property <length> attachment-height: attachment.viewer-height;
    callback update-attachment-webview();
    changed attachment-x => { root.update-attachment-webview(); }
    changed attachment-y => { root.update-attachment-webview(); }
    changed attachment-width => { root.update-attachment-webview(); }
    changed attachment-height => { root.update-attachment-webview(); }
    out property <length> document-x: document.viewer-x;
    out property <length> document-y: document.viewer-y;
    out property <length> document-width: document.viewer-width;
    out property <length> document-height: document.viewer-height;
    private property <bool> document-visible: UiState.screen == Screen.document;
    callback update-document-webview();
    changed document-x => { root.update-document-webview(); }
    changed document-y => { root.update-document-webview(); }
    changed document-width => { root.update-document-webview(); }
    changed document-height => { root.update-document-webview(); }
    changed document-visible => { root.update-document-webview(); }

    private property <bool> has-dialog: AttachmentMenu.visible || UiState.screen == Screen.onboarding;

    // since slint forces the menu bar to be in the main app window, there might not be a
    // better way to do this
    if !WindowChrome.client-side || !has-dialog || AttachmentMenu.visible: MenuBar {
        if UiState.screen == Screen.onboarding && UiState.shortcut-modifier == "⌘": Menu {
            title: "Edit";
            MenuItem {
                title: "Cut";
                shortcut: @keys(Control + X);
                activated => {
                    if onboarding.input-has-focus { onboarding.edit-input(0); }
                    else { root.edit-webview(0); }
                }
            }

            MenuItem {
                title: "Copy";
                shortcut: @keys(Control + C);
                activated => {
                    if onboarding.input-has-focus { onboarding.edit-input(1); }
                    else { root.edit-webview(1); }
                }
            }

            MenuItem {
                title: "Paste";
                shortcut: @keys(Control + V);
                activated => {
                    if onboarding.input-has-focus { onboarding.edit-input(2); }
                    else { root.edit-webview(2); }
                }
            }

            MenuItem {
                title: "Select All";
                shortcut: @keys(Control + A);
                activated => {
                    if onboarding.input-has-focus { onboarding.edit-input(3); }
                    else { root.edit-webview(3); }
                }
            }
        }
        if !has-dialog: Menu {
            title: "Tabs";
            MenuItem {
                title: "Calendar";
                shortcut: @keys(Exclamation);   // shift + 1
                activated => { root.navigate-sidebar(0); }
            }

            MenuItem {
                title: "Notifications";
                shortcut: @keys(At);    // shift + 2
                activated => { root.navigate-sidebar(1); }
            }

            MenuItem {
                title: "Courses";
                shortcut: @keys(Hash);  // shift + 3
                activated => { root.navigate-sidebar(2); }
            }

            MenuItem {
                title: "Search";
                shortcut: @keys(Dollar);  // shift + 4
                activated => { root.navigate-sidebar(3); }
            }

            if CoursesUi.tabs.length > 0: MenuSeparator { }

            // i don't think there's a better way to do this either because the @keys must be hardcoded
            if CoursesUi.tabs.length > 0: MenuItem {
                title: "Tab 1";
                shortcut: @keys(Control + Digit1);
                enabled: CoursesUi.tabs.length > 0;
                activated => { root.navigate-sidebar(4); }
            }
            if CoursesUi.tabs.length > 1: MenuItem {
                title: "Tab 2";
                shortcut: @keys(Control + Digit2);
                enabled: CoursesUi.tabs.length > 1;
                activated => { root.navigate-sidebar(5); }
            }
            if CoursesUi.tabs.length > 2: MenuItem {
                title: "Tab 3";
                shortcut: @keys(Control + Digit3);
                enabled: CoursesUi.tabs.length > 2;
                activated => { root.navigate-sidebar(6); }
            }
            if CoursesUi.tabs.length > 3: MenuItem {
                title: "Tab 4";
                shortcut: @keys(Control + Digit4);
                enabled: CoursesUi.tabs.length > 3;
                activated => { root.navigate-sidebar(7); }
            }
            if CoursesUi.tabs.length > 4: MenuItem {
                title: "Tab 5";
                shortcut: @keys(Control + Digit5);
                enabled: CoursesUi.tabs.length > 4;
                activated => { root.navigate-sidebar(8); }
            }
            if CoursesUi.tabs.length > 5: MenuItem {
                title: "Tab 6";
                shortcut: @keys(Control + Digit6);
                enabled: CoursesUi.tabs.length > 5;
                activated => { root.navigate-sidebar(9); }
            }
            if CoursesUi.tabs.length > 6: MenuItem {
                title: "Tab 7";
                shortcut: @keys(Control + Digit7);
                enabled: CoursesUi.tabs.length > 6;
                activated => { root.navigate-sidebar(10); }
            }
            if CoursesUi.tabs.length > 7: MenuItem {
                title: "Tab 8";
                shortcut: @keys(Control + Digit8);
                enabled: CoursesUi.tabs.length > 7;
                activated => { root.navigate-sidebar(11); }
            }
            if CoursesUi.tabs.length > 8: MenuItem {
                title: "Tab 9";
                shortcut: @keys(Control + Digit9);
                enabled: CoursesUi.tabs.length > 8;
                activated => { root.navigate-sidebar(12); }
            }
            MenuSeparator { }

            MenuItem {
                title: "Previous sidebar item";
                shortcut: @keys(Control + Alt + UpArrow);
                activated => { root.step-sidebar(-1); }
            }

            MenuItem {
                title: "Next sidebar item";
                shortcut: @keys(Control + Alt + DownArrow);
                activated => { root.step-sidebar(1); }
            }
        }

        if !has-dialog && UiState.screen == Screen.dashboard: Menu {
            title: "Actions";
            for item[index] in DashboardMenu.items: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                activated => { DashboardMenu.activate(index); }
            }
        }
        if !has-dialog && UiState.screen == Screen.notifs: Menu {
            title: "Actions";
            for item[index] in NotificationsMenu.items: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                activated => { NotificationsMenu.activate(index); }
            }
        }
        if !has-dialog && UiState.screen == Screen.courses: Menu {
            title: "Actions";
            for item[index] in CoursesMenu.items: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                activated => { CoursesMenu.activate(index); }
            }
        }
        if !has-dialog && UiState.screen == Screen.materials: Menu {
            title: "Actions";
            for item[index] in MaterialsMenu.items: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                activated => { MaterialsMenu.activate(index); }
            }
        }
        if !has-dialog && (UiState.screen == Screen.assignment || UiState.screen == Screen.document): Menu {
            title: "Actions";
            for item[index] in AssignmentMenu.items: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                activated => { AssignmentMenu.activate(index); }
            }
        }
        if AttachmentMenu.visible: Menu {
            title: "Actions";
            for item[index] in AttachmentMenu.items: MenuItem {
                title: item.title;
                shortcut: item.shortcut;
                enabled: item.enabled;
                activated => { AttachmentMenu.activate(index); }
            }
        }
    }

    VerticalLayout {
        spacing: 0rem;
        Rectangle {
            vertical-stretch: 1;
            if UiState.screen == Screen.dashboard: Dashboard {
                width: parent.width;
                height: parent.height;
                sidebar-width: navigation.width;
                custom-titlebar: root.custom-titlebar;
            }

            if UiState.screen == Screen.notifs: Notifications {
                width: parent.width;
                height: parent.height;
                sidebar-width: navigation.width;
                custom-titlebar: root.custom-titlebar;
            }

            if UiState.screen == Screen.courses: Courses {
                width: parent.width;
                height: parent.height;
                sidebar-width: navigation.width;
                custom-titlebar: root.custom-titlebar;
            }
            if UiState.screen == Screen.search: Search {
                width: parent.width;
                height: parent.height;
                sidebar-width: navigation.width;
                custom-titlebar: root.custom-titlebar;
            }
            for tab[index] in CoursesUi.tabs: AssignmentView {
                tab: tab;
                visible: UiState.screen == Screen.assignment && CoursesUi.active-tab == index;
                width: parent.width;
                height: parent.height;
                sidebar-width: navigation.width;
                custom-titlebar: root.custom-titlebar;
            }
            for tab[index] in CoursesUi.tabs: Materials {
                tab: tab;
                visible: UiState.screen == Screen.materials && CoursesUi.active-tab == index;
                width: parent.width;
                height: parent.height;
                sidebar-width: navigation.width;
                custom-titlebar: root.custom-titlebar;
            }
            if UiState.screen == Screen.settings: Settings {
                width: parent.width;
                height: parent.height;
                sidebar-width: navigation.width;
                custom-titlebar: root.custom-titlebar;
            }

            onboarding := SchoologyOnboarding {
                visible: UiState.screen == Screen.onboarding;
                width: parent.width;
                height: parent.height;
                sidebar-width: navigation.width;
                custom-titlebar: root.custom-titlebar;
            }

            navigation := Sidebar {
                focus-request: root.sidebar-focus-request;
                x: 0rem;
                y: UiState.top-bar-height;
                height: parent.height - UiState.top-bar-height - UiState.bottom-bar-height;
            }

            document := DocumentView {
                visible: UiState.screen == Screen.document;
                tab: CoursesUi.active-tab >= 0 ? CoursesUi.tabs[CoursesUi.active-tab] : { };
                width: parent.width;
                height: parent.height;
                sidebar-width: navigation.width;
                custom-titlebar: root.custom-titlebar;
            }
        }
    }

    attachment := AttachmentDialog {
        visible: AttachmentMenu.visible;
        width: parent.width;
        height: parent.height;
    }

    if WindowChrome.client-side && AttachmentMenu.visible: WindowMoveArea {
        x: 0px;
        y: 0px;
        height: UiState.top-bar-height;
        TouchArea {
            double-clicked => { WindowChrome.toggle-maximized(); }
        }
    }

    // Native macOS controls also stay above the content and attachment overlay.
    if WindowChrome.client-side: WindowControls {
        x: parent.width - self.width;
        y: 0px;
        height: UiState.top-bar-height;
        active: root.window-active;
        maximized: root.maximized;
        full-screen: root.full-screen;
        close => { root.close(); }
        minimize => { root.minimized = true; }
        toggle-maximized => { WindowChrome.toggle-maximized(); }
    }
}
