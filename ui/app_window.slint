import { HorizontalBox } from "std-widgets.slint";
import { Dashboard } from "screen/dashboard.slint";
import { Screen } from "screen/screens.slint";
import { Theme } from "palette.slint";
import { Sidebar } from "sidebar.slint";
import { UiState } from "ui-state.slint";
export { UiState }from "ui-state.slint";
import "./fonts/MozillaText.ttf";
import { Notifications } from "screen/notifications.slint";

export component AppWindow inherits Window {
    title: "Foam";
    default-font-family: "Mozilla Text";
    preferred-width: 1200px;
    preferred-height: 800px;

    background: Theme.dark.background-800;

    HorizontalBox {
        padding: 0px;
        spacing: 0px;

        Sidebar { }

        Rectangle {
            horizontal-stretch: 1;
            vertical-stretch: 1;
            if UiState.screen == Screen.dashboard: Dashboard {
                width: parent.width;
                height: parent.height;
            }
            if UiState.screen == Screen.notifs: Notifications {
                width: parent.width;
                height: parent.height;
            }
        }
    }
}
