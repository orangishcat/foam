import {
    CoursesUi,
    UiState,
    DocumentUi,
    AssignmentUi,
    MaterialUi,
} from "../../globals.slint";
import { MaterialItem, CourseTab } from "../../types/course-ui.slint";
import { Icon } from "icon.slint";
import { HoverableButton } from "../hoverable-button.slint";

export component Row inherits Rectangle {
    in property <MaterialItem> item;
    in-out property <int> selected-index;
    in property <int> row-index: -999;
    in property <bool> selected;
    in property <bool> double-click: true;

    private property <bool> navigable: item.kind == "folder" || item.kind == "course";
    height: 2.5rem;
    border-radius: 0.3125rem;
    background: (selected || selected-index == row-index ? UiState.theme.background-600
        : (action.has-hover || action.has-focus ? UiState.theme.background-700 : transparent));
    HorizontalLayout {
        padding-left: 0.75rem;
        padding-right: 0.75rem;
        spacing: 0.625rem;
        VerticalLayout {
            alignment: center;
            Icon {
                width: 1.25rem;
                height: 1.25rem;
                kind: item.kind;
            }
        }

        Text {
            text: item.title;
            color: UiState.theme.text-50;
            vertical-alignment: center;
            overflow: elide;
            font-size: 1.125rem;
            horizontal-stretch: 1;
        }

        Text {
            font-size: 0.75rem;
            text: root.navigable ? "›" : "";
            color: UiState.theme.text-200;
            vertical-alignment: center;
        }
    }

    action := HoverableButton {
        text: item.title;
        clicked => {
            if double-click { selected-index = row-index; }
            else { MaterialUi.open(item); }
        }
        double-clicked => {
            MaterialUi.open(item);
        }
    }
}
