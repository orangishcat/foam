import { MaterialItem } from "../../types/course-ui.slint";
import { CoursesUi } from "../courses/globals.slint";
import { AssignmentUi } from "../assignment/globals.slint";
import { DocumentUi } from "../document/globals.slint";

export global MaterialUi {
    callback open-browser(MaterialItem);
    public function open(item: MaterialItem) {
        if item.kind == "course" {
            CoursesUi.open-folder(item.course-id, "");
        }
        if item.kind == "folder" {
            CoursesUi.open-folder(item.course-id, item.id);
        }
        if item.kind == "assignment" {
            AssignmentUi.open(item.course-id, item.id);
        }
        if item.kind == "document" { DocumentUi.open(item.course-id, item.id); }
    }
    public function open-in-browser(item: MaterialItem) {
        open-browser(item);
    }
}
