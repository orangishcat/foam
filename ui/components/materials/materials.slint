import { ScrollView } from "std-widgets.slint";
import { Screen } from "../../types/screen.slint";
import { Row } from "row.slint";
import { MaterialItem, CourseTab } from "../../types/course-ui.slint";
import {
    Breadcrumb,
} from "breadcrumb.slint";
import { Sidebar } from "sidebar.slint";
import { UiState, MenubarData } from "../../globals.slint";
import { CoursesUi } from "../courses/globals.slint";
import { MaterialUi } from "globals.slint";
import { TopBar } from "top-bar.slint";
import { BottomBarFrame } from "../bottom-bar-frame.slint";

import { MaterialsBottomBar } from "bottom-bar.slint";

export global MaterialsMenu {
    in-out property <int> selected-index: -1;
    private property <CourseTab> tab: CoursesUi.tabs[CoursesUi.active-tab];
    changed tab => { selected-index = -1; }
    changed selected-index => { MenubarData.refresh(); }
    private property <bool> has-selection: CoursesUi.active-tab >= 0
        && CoursesUi.active-tab < CoursesUi.tabs.length
        && selected-index >= 0 && selected-index < tab.materials.length;
    public function activate(index: int) {
        if index == 0 { CoursesUi.close-tab(CoursesUi.active-tab); }
        else if has-selection {
            if index == 1 { MaterialUi.open(tab.materials[selected-index]); }
            else if index == 2 { MaterialUi.open-in-browser(tab.materials[selected-index]); }
            else if index == 3 { selected-index = -1; }
        }
    }
}

export component Materials inherits Rectangle {
    in property <length> sidebar-width: 0rem;
    in property <bool> custom-titlebar: false;
    in property <CourseTab> tab;

    VerticalLayout {
        spacing: 0rem;
        TopBar {
            tab: root.tab;
            custom-titlebar: root.custom-titlebar;
        }

        Rectangle {
            vertical-stretch: 1;
            Rectangle {
                x: root.sidebar-width;
                width: parent.width - root.sidebar-width;
                height: parent.height;
                HorizontalLayout {
                    spacing: 0rem;
                    Sidebar {
                        tab <=> root.tab;
                    }

                    Rectangle {
                        horizontal-stretch: 1;
                        VerticalLayout {
                            padding-left: 1rem;
                            padding-right: 1rem;
                            list := ScrollView {
                                horizontal-scrollbar-policy: always-off;
                                VerticalLayout {
                                    padding-top: 1rem;
                                    padding-bottom: 1rem;
                                    for item[i] in root.tab.materials: VerticalLayout {
                                        padding-bottom: 0.25rem;
                                        Row {
                                            width: list.visible-width;
                                            item: item;
                                            selected-index <=> MaterialsMenu.selected-index;
                                            row-index: i;
                                        }

                                        if i < root.tab.materials.length - 1: Rectangle {
                                            border-width: 0.0625rem;
                                            height: 0.0625rem;
                                            border-color: UiState.theme.colors.elevate-2;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        MaterialsBottomBar {
            tab: root.tab;
            selected-index <=> MaterialsMenu.selected-index;
        }
    }
}
