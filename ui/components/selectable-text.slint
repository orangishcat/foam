import { UiState } from "../globals.slint";

export component SelectableText inherits TextInput {
    font-size: 0.75rem;
    read-only: true;
    single-line: false;
    selection-background-color: UiState.theme.colors.secondary-selected;
    selection-foreground-color: UiState.theme.colors.text-base;
    wrap: word-wrap;
}
