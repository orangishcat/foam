import { SelectedItemAction } from "../selected-item-action.slint";
import { NotificationUi } from "../../globals.slint";
import { BottomBarFrame } from "../bottom-bar-frame.slint";

export component NotificationsBottomBar inherits BottomBarFrame {
    Rectangle {
        HorizontalLayout {
            alignment: center;
            SelectedItemAction {
                hotkey-name: "A";
                hotkey: @keys(A);
                action-name: "Mark all as read";
                action => { NotificationUi.mark-all-as-read(); }
            }

            if !NotificationUi.selected-notification.id.is-empty && NotificationUi.can-open-selected: SelectedItemAction {
                hotkey-name: "V";
                hotkey: @keys(V);
                action-name: "View item";
                action => { NotificationUi.open-selected(); }
            }
            if !NotificationUi.selected-notification.id.is-empty: SelectedItemAction {
                hotkey-name: "D";
                hotkey: @keys(D);
                action-name: NotificationUi.selected-notification.unread ? "Mark as read" : "Mark as unread";
                action => { NotificationUi.toggle-selected-read(); }
            }
            if !NotificationUi.selected-notification.id.is-empty: SelectedItemAction {
                hotkey-name: "Esc";
                hotkey: @keys(Escape);
                action-name: "Unselect item";
                action => { NotificationUi.unselect(); }
            }
        }
    }
}
