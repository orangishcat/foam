import { Theme } from "../../palette.slint";
import {
    ScrollView,
    HorizontalBox,
    VerticalBox,
    ListView,
} from "std-widgets.slint";
import {
    UiState,
    NotificationUi,
    AssignmentUi,
    DocumentUi,
} from "../../globals.slint";
import { HoverableButton } from "../hoverable-button.slint";
import { NotificationType } from "../../types/notification-ui.slint";
import { NotificationsBottomBar } from "bottom-bar.slint";
import { ScreenTopBar } from "../screen-top-bar.slint";
import { ScreenMenuItem } from "../../types/screen-menu-item.slint";

export global NotificationsMenu {
    out property <[ScreenMenuItem]> items: [
        { title: "View item", shortcut: @keys(V), enabled: NotificationUi.can-open-selected },
        {
            title: "Mark as read",
            shortcut: @keys(D),
            enabled: !NotificationUi.selected-notification.id.is-empty
        },
        {
            title: "Unselect item",
            shortcut: @keys(Escape),
            enabled: !NotificationUi.selected-notification.id.is-empty
        },
    ];
    public function activate(index: int) {
        if index == 0 { NotificationUi.open-selected(); }
        else if index == 1 { NotificationUi.toggle-selected-read(); }
        else if index == 2 { NotificationUi.unselect(); }
    }
}

export component Notifications inherits FocusScope {
    in property <length> sidebar-width: 0rem;
    in property <bool> custom-titlebar: false;
    focus-on-tab-navigation: false;
    focus-on-click: false;
    init => { root.focus(); }
    Rectangle {
        background: UiState.theme.background-800;
    }

    VerticalLayout {
        spacing: 0rem;
        ScreenTopBar {
            custom-titlebar: root.custom-titlebar;
            title: "Notifications";
            icon: @image-url("../../icons/bell.svg");
        }

        Rectangle {
            vertical-stretch: 1;
            Rectangle {
                x: root.sidebar-width;
                width: parent.width - root.sidebar-width;
                height: parent.height;
                VerticalBox {
                    padding: 2rem;
                    ListView {
                        for notif in NotificationUi.notifications: Rectangle {
                            height: inner.height + 0.625rem;
                            inner := Rectangle {
                                border-radius: 0.3125rem;
                                border-width: 0.0625rem;
                                height: min(7.5rem, max(1.875rem, self.preferred-height));
                                border-color: UiState.theme.background-400;
                                background: NotificationUi.selected-notification.id == notif.id
                                    ? UiState.theme.background-500 : action.has-hover || action.has-focus
                                    ? UiState.theme.background-600 : UiState.theme.background-700;

                                preferred-height: title.preferred-height + course.preferred-height
                                    + content.padding-top + content.padding-bottom + 2rem;
                                clip: true;

                                HorizontalLayout {
                                    padding: 0.1245rem;
                                    alignment: start;
                                    spacing: 0.75rem;

                                    padding-left: 0.75rem;
                                    padding-right: 0.75rem;
                                    Rectangle {
                                        width: 0.625rem;
                                        height: 0.625rem;
                                        border-radius: 0.3125rem;
                                        background: notif.unread ? oklch(0.851, 0.06, 244.09, 1) : transparent;
                                        cross-axis-self-alignment: center;
                                    }

                                    if notif.n_type == NotificationType.new-assignment: Image {
                                        source: @image-url("../../icons/file-plus.svg");
                                        colorize: notif.icon-color;
                                        height: 4rem;
                                    }
                                    if notif.n_type == NotificationType.new-document: Image {
                                        source: @image-url("../../icons/file-text.svg");
                                        colorize: notif.icon-color;
                                        height: 4rem;
                                    }
                                    if notif.n_type == NotificationType.new-grade: Image {
                                        source: @image-url("../../icons/circle-check-big.svg");
                                        colorize: notif.icon-color;
                                        height: 4rem;
                                    }
                                    if notif.n_type == NotificationType.new_link: Image {
                                        source: @image-url("../../icons/link.svg");
                                        colorize: notif.icon-color;
                                        height: 4rem;
                                    }
                                    if notif.n_type == NotificationType.unknown: Image {
                                        source: @image-url("../../icons/square-plus.svg");
                                        colorize: notif.icon-color;
                                        height: 4rem;
                                    }
                                    content := VerticalLayout {
                                        spacing: 0.25rem;
                                        title := Text {
                                            text: notif.title;
                                            font-size: 1.125rem;
                                            font-weight: 700;
                                            vertical-alignment: bottom;
                                            wrap: word-wrap;
                                        }

                                        course := Text {
                                            color: UiState.theme.text-400;
                                            font-size: 0.75rem;
                                            text: notif.course;
                                            vertical-alignment: top;
                                            wrap: word-wrap;
                                        }
                                    }
                                }

                                action := HoverableButton {
                                    text: notif.title;
                                    clicked => {
                                        NotificationUi.selected-notification = notif;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        NotificationsBottomBar { }
    }
}
