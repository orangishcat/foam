import { UiState } from "../globals.slint";
import { ScrollView } from "std-widgets.slint";

export component LineEdit inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text;
    in property <InputType> input-type <=> input.input-type;
    in property <image> icon;
    // When set, text wraps at the element's exact width instead of scrolling
    // horizontally, and the element grows vertically with the wrapped text.
    in property <bool> wrap: false;
    in property <bool> read-only: false;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted;
    // Intercept keys before the internal text editing; returning accept skips it.
    callback key-pressed(KeyEvent) -> EventResult;
    forward-focus: input;
    min-height: 2rem;
    min-width: 10rem;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: 4px;
    background: UiState.theme.colors.elevate-2;
    border-width: 0.0625rem;
    border-color: UiState.theme.colors.border;
    public function cut() { input.cut(); }
    public function copy() { input.copy(); }
    public function paste() { input.paste(); }
    public function select-all() { input.select-all(); }
    public function focus-input() { input.focus() }
    ContextMenuArea {
        width: parent.width;
        height: parent.height;
        Menu {
            MenuItem {
                title: "Cut";
                enabled: !root.text.is-empty;
                activated => { input.focus(); root.cut(); }
            }

            MenuItem {
                title: "Copy";
                enabled: !root.text.is-empty;
                activated => { input.focus(); root.copy(); }
            }

            MenuItem {
                title: "Paste";
                activated => { input.focus(); root.paste(); }
            }

            MenuSeparator { }

            MenuItem {
                title: "Select All";
                enabled: !root.text.is-empty;
                activated => { input.focus(); root.select-all(); }
            }
        }

        TouchArea {
            mouse-cursor: MouseCursor.text;
            clicked => { input.focus(); }
        }

        HorizontalLayout {
            padding: 0.5rem;
            alignment: stretch;
            HorizontalLayout {
                horizontal-stretch: 0;
                alignment: start;
                spacing: 0.5rem;
                if icon.width > 0: VerticalLayout {
                    alignment: center;
                    Image {
                        source: icon;
                        colorize: UiState.theme.colors.text-tertiary;
                        width: 1rem;
                        height: 1rem;
                        vertical-alignment: center;
                    }
                }
            }

            HorizontalLayout {
                horizontal-stretch: 1;
                padding-left: icon.width > 0 ? 0.5rem : 0px;
                Rectangle {
                    clip: true;
                    min-width: 1px;
                    horizontal-stretch: 1;
                    scroll := ScrollView {
                        min-width: 0px;
                        min-height: 0px;
                        width: parent.width;
                        height: parent.height;
                        // Text never scrolls horizontally: the single-line input shifts
                        // internally via scroll-x, the wrapped input wraps at the width.
                        horizontal-scrollbar-policy: always-off;
                        vertical-scrollbar-policy: root.wrap ? as-needed : always-off;
                        content-width: self.visible-width;
                        content-height: root.wrap ? max(self.visible-height, input.preferred-height) : self.visible-height;

                        input := TextInput {
                            property <length> scroll-x;
                            x: root.wrap ? 0px : min(0px, max(parent.width - self.width - self.text-cursor-width, self.scroll-x));
                            width: root.wrap ? parent.width : max(parent.width - self.text-cursor-width, self.preferred-width);
                            height: root.wrap ? max(scroll.visible-height, self.preferred-height) : parent.height;
                            single-line: !root.wrap;
                            read-only: root.read-only;
                            wrap: root.wrap ? word-wrap : no-wrap;
                            vertical-alignment: root.wrap ? TextVerticalAlignment.top : TextVerticalAlignment.center;
                            color: UiState.theme.colors.text-strong;
                            selection-background-color: UiState.theme.colors.border;
                            selection-foreground-color: UiState.theme.colors.text-strong;
                            key-pressed(event) => {
                                if root.key-pressed(event) == EventResult.accept {
                                    return accept;
                                }
                                if root.wrap && event.text == Key.Return && !event.modifiers.shift {
                                    // In multiline fields only Shift+Enter inserts a
                                    // new line; plain Enter stays a submit hotkey.
                                    root.accepted();
                                    return accept;
                                }
                                reject
                            }
                            cursor-position-changed(position) => {
                                if root.wrap {
                                    // Keep the cursor line visible by scrolling vertically.
                                    if position.y + scroll.content-y < 0px {
                                        scroll.content-y = -position.y;
                                    } else if position.y + scroll.content-y > scroll.visible-height {
                                        scroll.content-y = scroll.visible-height - position.y;
                                    }
                                } else {
                                    if position.x + self.scroll-x < 0px {
                                        self.scroll-x = -position.x;
                                    } else if position.x + self.scroll-x > parent.width - self.text-cursor-width {
                                        self.scroll-x = parent.width - position.x - self.text-cursor-width;
                                    }
                                }
                            }
                            edited => { root.edited(self.text); }
                            accepted => { root.accepted(); }
                        }
                    }

                    Text {
                        width: parent.width;
                        height: parent.height;
                        visible: input.text.is-empty;
                        text: root.placeholder-text;
                        color: UiState.theme.colors.text-muted;
                        vertical-alignment: top;
                        horizontal-alignment: left;
                    }
                }
            }
        }
    }
}
