import { UiState } from "../globals.slint";

export component LineEdit inherits Rectangle {
    in-out property <string> text <=> input.text;
    in property <string> placeholder-text;
    in property <InputType> input-type <=> input.input-type;
    in property <image> icon;
    out property <bool> has-focus: input.has-focus;
    callback edited(string);
    callback accepted;
    forward-focus: input;
    min-height: 2rem;
    min-width: 10rem;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: 4px;
    background: UiState.theme.background-700;
    border-width: 1px;
    border-color: UiState.theme.background-400;
    public function cut() { input.cut(); }
    public function copy() { input.copy(); }
    public function paste() { input.paste(); }
    public function select-all() { input.select-all(); }
    public function focus-input() { input.focus() }
    ContextMenuArea {
        width: parent.width;
        height: parent.height;
        Menu {
            MenuItem {
                title: "Cut";
                enabled: !root.text.is-empty;
                activated => { input.focus(); root.cut(); }
            }
            MenuItem {
                title: "Copy";
                enabled: !root.text.is-empty;
                activated => { input.focus(); root.copy(); }
            }
            MenuItem {
                title: "Paste";
                activated => { input.focus(); root.paste(); }
            }
            MenuSeparator { }
            MenuItem {
                title: "Select All";
                enabled: !root.text.is-empty;
                activated => { input.focus(); root.select-all(); }
            }
        }
    TouchArea {
        mouse-cursor: MouseCursor.text;
        clicked => { input.focus(); }
    }

    HorizontalLayout {
        padding: 0.5rem;
        alignment: stretch;
        HorizontalLayout {
            horizontal-stretch: 0;
            alignment: start;
            spacing: 0.5rem;
            if icon.width > 0: VerticalLayout {
                alignment: center;
                Image {
                    source: icon;
                    colorize: UiState.theme.text-300;
                    width: 1rem;
                    height: 1rem;
                    vertical-alignment: center;
                }
            }
        }

        HorizontalLayout {
            horizontal-stretch: 1;
            padding-left: icon.width > 0 ? 0.5rem : 0px;
            Rectangle {
                clip: true;
                min-width: 1px;
                horizontal-stretch: 1;
                input := TextInput {
                    property <length> scroll-x;
                    x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.scroll-x));
                    width: max(parent.width - self.text-cursor-width, self.preferred-width);
                    height: parent.height;
                    single-line: true;
                    vertical-alignment: center;
                    color: UiState.theme.text-100;
                    selection-background-color: UiState.theme.background-400;
                    selection-foreground-color: UiState.theme.text-100;
                    cursor-position-changed(position) => {
                        if position.x + self.scroll-x < 0px {
                            self.scroll-x = -position.x;
                        } else if position.x + self.scroll-x > parent.width - self.text-cursor-width {
                            self.scroll-x = parent.width - position.x - self.text-cursor-width;
                        }
                    }
                    edited => { root.edited(self.text); }
                    accepted => { root.accepted(); }
                }
                Text {
                    width: parent.width;
                    height: parent.height;
                    visible: input.text.is-empty;
                    text: root.placeholder-text;
                    color: UiState.theme.text-400;
                    vertical-alignment: center;
                    horizontal-alignment: left;
                }
            }
        }
    }
    }
}
