import { CourseItem, MaterialItem, CourseTab } from "../../types/course-ui.slint";
import { MenubarData } from "../../globals.slint";

export global CoursesUi {
    in-out property <bool> show-hidden: false;
    changed show-hidden => { MenubarData.refresh(); }
    in-out property <[CourseTab]> tabs;
    changed tabs => { MenubarData.refresh(); }
    in-out property <int> active-tab: -1;
    changed active-tab => { MenubarData.refresh(); }
    callback select-tab(int);
    callback close-tab(int);
    in-out property <string> course-id;
    in-out property <string> folder-id;
    in-out property <string> folder-title: "Courses";
    in-out property <string> parent-title: "Courses";
    in-out property <string> browser-error;
    in-out property <[MaterialItem]> materials;
    in-out property <[MaterialItem]> parent-materials;
    callback open(string);
    callback open-with-image(string, image);
    callback open-folder(string, string);
    in-out property <[CourseItem]> courses;
    in-out property <int> period-character-count: 1;
    callback reorder(int, int);
    callback toggle-hidden(string);
    callback set-period(string, string) -> string;
    pure callback drag-data(int) -> data-transfer;
    pure callback drag-index(data-transfer) -> int;
}
