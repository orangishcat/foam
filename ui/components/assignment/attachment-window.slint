import { UiState, MenubarData } from "../../globals.slint";
import { SelectedItemAction } from "../selected-item-action.slint";
import { BottomBarFrame } from "../bottom-bar-frame.slint";
import { ScreenTopBar } from "../screen-top-bar.slint";
import { UnsupportedFile } from "../unsupported-file.slint";

export global AttachmentMenu {
    in-out property <bool> visible;
    in-out property <string> caption;
    in-out property <string> error;
    in-out property <bool> unsupported;
    in-out property <string> extension;
    in-out property <bool> is-office-document;
    in-out property <bool> file-ready;
    in-out property <int> index;
    in-out property <int> count;
    changed visible => { MenubarData.refresh(); }
    changed index => { MenubarData.refresh(); }
    changed count => { MenubarData.refresh(); }
    changed file-ready => { MenubarData.refresh(); }
    in-out property <string> kind: "attachment";
    callback step(int);
    callback open-browser();
    callback open-external();
    callback open-libreoffice-link();
    callback reveal-file();
    callback close-preview();
    public function activate(index: int) {
        if index == 0 { step(-1); }
        else if index == 1 { step(1); }
        else if index == 2 { close-preview(); }
        else if index == 3 && file-ready { reveal-file(); }
    }
}

export component AttachmentDialog inherits Rectangle {
    visible: AttachmentMenu.visible;
    background: UiState.theme.overrides.attachment-backdrop.with-alpha(0.667);
    out property <length> viewer-x: panel.x;
    out property <length> viewer-y: panel.y + UiState.top-bar-height;
    out property <length> viewer-width: panel.width;
    out property <length> viewer-height: max(0rem, panel.height - UiState.top-bar-height);
    TouchArea {
        clicked => { AttachmentMenu.close-preview(); }
    }

    panel := Rectangle {
        x: 1.5rem;
        y: UiState.top-bar-height + 0.75rem;
        width: max(0rem, root.width - 3rem);
        height: max(0rem, root.height - self.y - 1.5rem);
        background: UiState.theme.colors.background;
        border-radius: 0.625rem;
        clip: true;
        TouchArea { }

        VerticalLayout {
            spacing: 0rem;
            ScreenTopBar {
                title: AttachmentMenu.caption + " • " + (AttachmentMenu.index + 1) + " / " + AttachmentMenu.count;
                icon: @image-url("../../icons/file-text.svg");

                Rectangle {
                    horizontal-stretch: 1;
                }

                if AttachmentMenu.index > 0: SelectedItemAction {
                    hotkey-name: "←";
                    hotkey: @keys(LeftArrow);
                    action-name: "Previous";
                    action => { AttachmentMenu.activate(0); }
                }
                if AttachmentMenu.index + 1 < AttachmentMenu.count: SelectedItemAction {
                    hotkey-name: "→";
                    hotkey: @keys(RightArrow);
                    action-name: "Next ";
                    action => { AttachmentMenu.activate(1); }
                }

                if AttachmentMenu.file-ready: SelectedItemAction {
                    hotkey-name: "O";
                    hotkey: @keys(O);
                    action-name: "Open in file manager";
                    action => { AttachmentMenu.activate(3); }
                }

                SelectedItemAction {
                    hotkey-name: "Esc";
                    hotkey: @keys(Escape);
                    action-name: "Close preview";
                    action => { AttachmentMenu.activate(2); }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 1rem;
                padding: 1.5rem;
                horizontal-stretch: 1;
                vertical-stretch: 1;
                if !AttachmentMenu.unsupported: Text {
                    text: AttachmentMenu.error.is-empty ? "Loading " + AttachmentMenu.kind + "…" : AttachmentMenu.error;
                    color: UiState.theme.colors.text-strong;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    font-size: 0.875rem;
                    horizontal-stretch: 1;
                    vertical-stretch: 0;
                }
                if AttachmentMenu.unsupported: UnsupportedFile {
                    extension: AttachmentMenu.extension;
                    is-office-document: AttachmentMenu.is-office-document;
                    file-ready: AttachmentMenu.file-ready;
                    error: AttachmentMenu.error;
                    open-libreoffice-link => { AttachmentMenu.open-libreoffice-link(); }
                    open-external => { AttachmentMenu.open-external(); }
                    reveal-file => { AttachmentMenu.reveal-file(); }
                }
            }
        }
    }
}
