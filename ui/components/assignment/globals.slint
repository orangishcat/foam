import { AssignmentWithDetails } from "../../types/assignment-ui.slint";
import { MenubarData } from "../../globals.slint";

export global AssignmentUi {
    in-out property <AssignmentWithDetails> assignment;
    changed assignment => { MenubarData.refresh(); }
    in-out property <string> error;
    callback open(string, string);
    callback copy-details(string);
    callback view-attachments(int);
    callback view-submissions(int);
    callback open-browser(string);

    public function open-selected-in-browser() {
        open-browser(assignment.id);
    }
}
