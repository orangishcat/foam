import { LineEdit } from "../line-edit.slint";
import {
    DatePickerPopup,
    TimePickerPopup,
    Date,
    Time,
} from "std-widgets.slint";
import { FilledButton } from "@vivi/magic.slint";
import { HoverableButton } from "../hoverable-button.slint";
import { SelectedItemAction } from "../selected-item-action.slint";
import { UiState, MenubarData } from "../../globals.slint";
import { ScreenTopBar } from "../screen-top-bar.slint";
import { SelectedItemAction } from "../selected-item-action.slint";

export global NewEventUi {
    in-out property <bool> visible;
    in-out property <string> title;
    in-out property <string> description;
    in-out property <Date> date;
    in-out property <Time> time;
    in-out property <string> editing-id;
    out property <bool> editing: !editing-id.is-empty;
    // title, description, year, month, day, hour, minute
    callback create(string, string, int, int, int, int, int);
    callback delete();
    public pure function pad(number: int) -> string {
        // Slint has no zero-padding helper, so pad each field inline.
        return (number < 10 ? "0" : "") + number;
    }
    public function close() {
        self.visible = false;
        MenubarData.refresh();
    }
    public function submit() {
        if root.title.is-empty { return; }
        root.create(root.title, root.description,
            root.date.year, root.date.month, root.date.day,
            root.time.hour, root.time.minute);
    }
    changed visible => { MenubarData.refresh(); }
}

export component NewEventDialog inherits Rectangle {
    background: UiState.theme.overrides.attachment-backdrop.with-alpha(0.667);
    TouchArea {
        clicked => { NewEventUi.close(); }
    }

    panel := Rectangle {
        width: 36rem;
        height: self.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: UiState.theme.colors.background;
        border-radius: 0.625rem;
        clip: true;
        TouchArea { }

        FocusScope {
            key-pressed(event) => {
                if event.text == Key.Escape {
                    NewEventUi.close();
                    accept
                } else if event.text == Key.Return {
                    NewEventUi.submit();
                    accept
                } else if event.modifiers.control && event.text == Key.Delete {
                    NewEventUi.delete();
                    accept
                } else {
                    reject
                }
            }
        }

        VerticalLayout {
            ScreenTopBar {
                title: NewEventUi.editing ? "Edit event" : "New event";
                icon: @image-url("../../icons/calendar-days.svg");

                Rectangle {
                    horizontal-stretch: 1;
                }

                SelectedItemAction {
                    hotkey-name: "Enter";
                    hotkey: @keys(Return);
                    action-name: NewEventUi.editing ? "Save" : "Create";
                    action => { NewEventUi.submit(); }
                }

                SelectedItemAction {
                    hotkey-name: "Esc";
                    hotkey: @keys(Escape);
                    action-name: "Cancel";
                    action => { NewEventUi.close(); }
                }

                if NewEventUi.editing: SelectedItemAction {
                    hotkey-name: "\{UiState.shortcut-modifier}+Delete";
                    hotkey: @keys(Control+Delete);
                    action-name: "Delete";
                    action => { NewEventUi.delete(); }
                }
            }

            VerticalLayout {
                padding: 1rem;
                padding-top: 0.75rem;
                spacing: 0.75rem;

                title-input := LineEdit {
                    placeholder-text: "Title";
                    text <=> NewEventUi.title;
                    accepted => { NewEventUi.submit(); }
                    init => { self.focus-input(); }
                }

                HorizontalLayout {
                    spacing: 0.75rem;

                    HoverableButton {
                        horizontal-stretch: 1;
                        accessible-role: button;
                        accessible-label: "Pick date";
                        clicked => { date-picker.show(); }

                        Rectangle {
                            background: parent.has-hover ? UiState.theme.colors.surface-hover : UiState.theme.colors.surface-4;
                            border-color: UiState.theme.colors.border;
                            border-width: 0.0625rem;
                            border-radius: 0.25rem;
                        }

                        HorizontalLayout {
                            padding: 0.5rem;
                            spacing: 0.5rem;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../../icons/calendar-days.svg");
                                    colorize: UiState.theme.colors.text-secondary;
                                    width: 1rem;
                                    height: 1rem;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: "\{NewEventUi.pad(NewEventUi.date.year)}-\{NewEventUi.pad(NewEventUi.date.month)}-\{NewEventUi.pad(NewEventUi.date.day)}";
                                font-size: 1rem;
                                vertical-alignment: center;
                                color: UiState.theme.colors.text-secondary;
                            }
                        }

                        date-picker := DatePickerPopup {
                            date: NewEventUi.date;
                            accepted(date) => { NewEventUi.date = date; }
                            canceled => {}
                        }
                    }

                    HoverableButton {
                        horizontal-stretch: 1;
                        accessible-role: button;
                        accessible-label: "Pick time";
                        clicked => { time-picker.show(); }

                        Rectangle {
                            background: parent.has-hover ? UiState.theme.colors.surface-hover : UiState.theme.colors.surface-4;
                            border-width: 0.0625rem;
                            border-color: UiState.theme.colors.border;
                            border-radius: 0.25rem;
                        }

                        HorizontalLayout {
                            padding: 0.5rem;
                            spacing: 0.5rem;

                            VerticalLayout {
                                alignment: center;
                                Image {
                                    source: @image-url("../../icons/clock.svg");
                                    colorize: UiState.theme.colors.text-secondary;
                                    width: 1rem;
                                    height: 1rem;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: "\{NewEventUi.pad(NewEventUi.time.hour)}:\{NewEventUi.pad(NewEventUi.time.minute)}";
                                font-size: 1rem;
                                vertical-alignment: center;
                                color: UiState.theme.colors.text-secondary;
                            }
                        }

                        time-picker := TimePickerPopup {
                            time: NewEventUi.time;
                            use-24-hour-format: true;
                            accepted(time) => { NewEventUi.time = time; }
                            canceled => {}
                        }
                    }
                }

                LineEdit {
                    placeholder-text: "Description (optional)";
                    height: 12rem;
                    text <=> NewEventUi.description;
                    wrap: true;
                    accepted => { NewEventUi.submit(); }
                }
            }
        }
    }
}
