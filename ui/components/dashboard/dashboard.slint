import {
    HorizontalBox,
    VerticalBox,
    ScrollView,
    ListView,
} from "std-widgets.slint";
import { HoverableButton } from "../hoverable-button.slint";
import { Theme } from "../../palette.slint";
import { DashboardUi } from "globals.slint";
import { AssignmentUi } from "../assignment/globals.slint";
import { UiState } from "../../globals.slint";
import { DashboardBottomBar } from "bottom-bar.slint";
import { ScreenTopBar } from "../screen-top-bar.slint";

import { ScreenMenuItem } from "../../types/screen-menu-item.slint";

export global DashboardMenu {
    out property <[ScreenMenuItem]> items: [
        {
            title: "View item",
            shortcut: @keys(V),
            enabled: !DashboardUi.selected-assignment.course-id.is-empty
        },
        {
            title: DashboardUi.selected-assignment.done ? "Unmark as done" : "Mark as done",
            shortcut: @keys(D),
            enabled: !DashboardUi.selected-assignment.course-id.is-empty
        },
        {
            title: "Unselect item",
            shortcut: @keys(Escape),
            enabled: !DashboardUi.selected-assignment.course-id.is-empty
        },
        { title: "Refresh", shortcut: @keys(Control + R), enabled: true }
    ];
    public function activate(index: int) {
        if index == 0 { DashboardUi.open-selected(); }
        else if index == 1 { DashboardUi.toggle-selected-done(); }
        else if index == 2 { DashboardUi.unselect(); }
        else if index == 3 { DashboardUi.refresh(); }
    }
}

export component Dashboard inherits FocusScope {
    in property <length> sidebar-width: 0rem;
    in property <bool> custom-titlebar: false;
    focus-on-tab-navigation: false;
    focus-on-click: false;
    init => { root.focus(); }

    Rectangle {
        background: UiState.theme.colors.background;
    }

    vertical-stretch: 1;

    VerticalLayout {
        spacing: 0rem;
        vertical-stretch: 1;
        ScreenTopBar {
            custom-titlebar: root.custom-titlebar;
            title: "Dashboard";
            icon: @image-url("../../icons/calendar-days.svg");

            Rectangle {
                horizontal-stretch: 1;
            }

            new-event-btn := HoverableButton {
                Rectangle {
                    y: 0.35rem;
                    height: parent.height - 0.7rem;
                    background: new-event-btn.has-hover ? UiState.theme.colors.surface-hover : transparent;
                    border-radius: 0.25rem;
                }

                HorizontalLayout {
                    padding-left: 0.5rem;
                    padding-right: 0.5rem;
                    spacing: 0.25rem;
                    VerticalLayout {
                        alignment: center;
                        icon := Image {
                            source: @image-url("../../icons/plus.svg");
                            colorize: UiState.theme.colors.text-secondary;
                            width: 0.75rem;
                            height: 0.75rem;
                        }
                    }

                    VerticalLayout {
                        alignment: center;

                        text := Text {
                            text: "New event";
                            font-size: 0.75rem;
                            color: UiState.theme.colors.text-secondary;
                        }
                    }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            Rectangle {
                x: root.sidebar-width;
                width: parent.width - root.sidebar-width;
                height: parent.height;
                HorizontalBox {
                    for col[x] in DashboardUi.assignment-view: VerticalBox {
                        alignment: stretch;
                        vertical-stretch: 1;

                        Text {
                            font-size: 0.75rem;
                            text: col.title;
                            color: UiState.theme.colors.text-base;
                            horizontal-alignment: center;
                        }

                        Rectangle {
                            background: UiState.theme.colors.elevate-1;
                            ListView {
                                vertical-stretch: 1;
                                horizontal-scrollbar-policy: always-off;
                                content-width: self.visible-width;
                                for assignment[y] in col.assignments: Rectangle {
                                    height: inner.height + 0.5rem;
                                    item-button := HoverableButton {
                                        text: assignment.title;
                                        clicked => {
                                            DashboardUi.selected-assignment = assignment;
                                            DashboardUi.sel-col = x;
                                            DashboardUi.sel-row = y;
                                        }
                                        double-clicked => {
                                            DashboardUi.selected-assignment = assignment;
                                            DashboardUi.open-selected();
                                        }
                                    }

                                    inner := Rectangle {
                                        background: {
                                            let c = (assignment.done ? UiState.theme.colors.progress-9 :
                                                (assignment.overdue ? UiState.theme.overrides.dashboard-overdue :
                                                UiState.theme.overrides.dashboard-pending)).to-oklch();
                                            let selected = DashboardUi.selected-assignment.id == assignment.id;

                                            oklch(
                                            c.lightness + (item-button.has-hover || item-button.has-focus ? 0.1 : 0) + (selected ? 0.2 : 0),
                                            c.chroma + (item-button.has-hover || item-button.has-focus ? 0.02 : 0) + (selected ? 0.06 : 0),
                                            c.hue,
                                            c.alpha)
                                        };
                                        animate background { duration: 50ms; }
                                        border-radius: 0.3125rem;
                                        height: min(7.5rem, max(2.5rem, self.preferred-height));
                                    // Text measurements include font size, weight, and wrapping.
                                    preferred-height: title.preferred-height + course.preferred-height
                                            + content.padding-top + content.padding-bottom + 1rem;
                                        clip: true;

                                        content := VerticalBox {
                                            spacing: 0.125rem;
                                            title := Text {
                                                font-size: 0.75rem;
                                                text: assignment.title;
                                                color: UiState.theme.colors.text-base;
                                                font-weight: 700;
                                                wrap: word-wrap;
                                            }

                                            course := Text {
                                                font-size: 0.75rem;
                                                color: UiState.theme.colors.text-muted;
                                                text: assignment.course-name;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        DashboardBottomBar { }
    }
}
