export struct SearchResult {
    item-id: string,
    course-id: string,
    title: string,
    item_type: string,
    course-title: string,
    preview: string,
    icon: image
}

export global SearchUi {
    in-out property <string> query;
    in-out property <[SearchResult]> results;
    in-out property <bool> busy;
    in-out property <string> error;
    callback search(string);
}
