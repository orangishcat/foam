import { ScreenTopBar } from "../screen-top-bar.slint";
import { BottomBarFrame } from "../bottom-bar-frame.slint";
import { ListView } from "std-widgets.slint";
import { LineEdit } from "../line-edit.slint";
import {
    UiState,
    SearchUi,
    AssignmentUi,
    DocumentUi,
    CoursesUi,
} from "../../globals.slint";
import { HoverableButton } from "../hoverable-button.slint";

export component Search inherits FocusScope {
    in property <length> sidebar-width: 0rem;
    in property <bool> custom-titlebar: false;
    init => { input.focus(); }
    VerticalLayout {
        spacing: 0rem;
        vertical-stretch: 1;
        ScreenTopBar {
            custom-titlebar: root.custom-titlebar;
            title: "Search";
            icon: @image-url("../../icons/search.svg");
        }

        Rectangle {
            vertical-stretch: 1;
            Rectangle {
                x: root.sidebar-width;
                width: parent.width - root.sidebar-width;
                height: parent.height;
                VerticalLayout {
                    padding: 1.5rem;
                    spacing: 1rem;
                    input := LineEdit {
                        text <=> SearchUi.query;
                        placeholder-text: "Search";
                        icon: @image-url("../../icons/search.svg");
                        edited(text) => { SearchUi.search(text); }
                        accepted => { SearchUi.search(self.text); }
                    }

                    Text {
                        color: UiState.theme.text-400;
                        text: !SearchUi.error.is-empty ? SearchUi.error : SearchUi.busy ? "Searching…"
                            : SearchUi.query.is-empty ? ""
                            : SearchUi.results.length == 0 ? "No assignments found."
                            : SearchUi.results.length == 30 ? "30+ results (capped at 30)"
                            : SearchUi.results.length + " results";
                        wrap: word-wrap;
                    }

                    ListView {
                        for result in SearchUi.results: VerticalLayout {
                            padding-bottom: 0.5rem;
                            Rectangle {
                                border-radius: 0.3125rem;
                                background: action.has-hover || action.has-focus ? UiState.theme.background-600 : UiState.theme.background-700;
                                HorizontalLayout {
                                    spacing: 0.5rem;
                                    padding-left: 1rem;
                                    padding-right: 1rem;
                                    alignment: start;
                                    VerticalLayout {
                                        alignment: center;
                                        Rectangle {
                                            width: 4rem;
                                            height: 4rem;
                                            border-radius: 1rem;
                                            clip: true;
                                            Image {
                                                width: 4rem;
                                                height: 4rem;
                                                source: result.icon;
                                                image-fit: ImageFit.contain;
                                            }

                                            if result.icon.width == 0: Image {
                                                width: parent.width;
                                                height: parent.height;
                                                source: result.item-type == "course" ? @image-url("../../icons/book-text.svg")
                                                    : result.item-type == "assignment" ? @image-url("../../icons/circle-check-big.svg")
                                                    : @image-url("../../icons/file-text.svg");
                                            }
                                        }
                                    }

                                    VerticalLayout {
                                        padding: 0.75rem;
                                        spacing: 0.25rem;
                                        alignment: start;
                                        Text {
                                            text: result.title;
                                            font-weight: 700;
                                            font-size: 1rem;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: result.course-title;
                                            color: UiState.theme.text-400;
                                            font-size: 0.8rem;
                                            overflow: elide;
                                        }

                                        if !result.preview.is-empty: Text {
                                            text: result.preview;
                                            wrap: word-wrap;
                                            overflow: elide;
                                            font-size: 0.75rem;
                                            vertical-stretch: 1;
                                        }
                                    }
                                }

                                action := HoverableButton {
                                    text: result.title;
                                    clicked => {
                                        result.item_type == "assignment" ? AssignmentUi.open(result.course-id, result.item-id)
                                            : result.item_type == "document" ? DocumentUi.open(result.course-id, result.item-id)
                                            : CoursesUi.open(result.course-id);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        BottomBarFrame { }
    }
}
