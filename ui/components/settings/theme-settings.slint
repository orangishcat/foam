import { Slider, Button } from "std-widgets.slint";
import { UiState } from "../../globals.slint";
import { Theme } from "../../palette.slint";
import { PalettePreview } from "../palette-preview.slint";

// A single customizable base color: a labeled swatch that expands into
// lightness, chroma, and hue controls (oklch) when tapped.
component ColorField inherits VerticalLayout {
    in property <string> label;
    in-out property <color> color;
    in property <bool> expanded;
    callback toggle();

    private property <float> lightness: root.color.to-oklch().lightness;
    private property <float> chroma: root.color.to-oklch().chroma;
    private property <float> hue: root.color.to-oklch().hue;

    spacing: 0.5rem;
    HorizontalLayout {
        spacing: 0.75rem;
        Rectangle {
            width: 2.5rem;
            height: 1.75rem;
            border-radius: 0.25rem;
            background: root.color;
            border-width: 1px;
            border-color: UiState.theme.background-600;
            TouchArea {
                clicked => { root.toggle(); }
            }
        }

        Text {
            vertical-alignment: center;
            text: root.label;
            font-size: 1.25rem;
            color: UiState.theme.text-200;
        }

        Rectangle {
            horizontal-stretch: 1;
        }

        Text {
            vertical-alignment: center;
            font-size: 0.75rem;
            color: UiState.theme.text-400;
            text: round((root.lightness * 100)) + "%, " + round(root.chroma * 1000) / 10 + ", " + round(root.hue) + "°";
        }
    }

    if root.expanded: VerticalLayout {
        spacing: 0.5rem;
        padding: 0.75rem;

        // lightness
        HorizontalLayout {
            spacing: 0.75rem;
            Text {
                width: 5rem;
                vertical-alignment: center;
                text: "Lightness";
                font-size: 0.875rem;
                color: UiState.theme.text-300;
            }
            Slider {
                minimum: 0.05;
                maximum: 0.98;
                value: root.lightness;
                changed value => {
                    root.color = oklch(self.value, root.chroma, root.hue);
                }
            }
            Text {
                width: 3rem;
                vertical-alignment: center;
                font-size: 0.875rem;
                color: UiState.theme.text-300;
                text: round(root.lightness * 100) + "%";
            }
        }

        // chroma (saturation)
        HorizontalLayout {
            spacing: 0.75rem;
            Text {
                width: 5rem;
                vertical-alignment: center;
                text: "Saturation";
                font-size: 0.875rem;
                color: UiState.theme.text-300;
            }
            Slider {
                minimum: 0;
                maximum: 0.2;
                value: root.chroma;
                changed value => {
                    root.color = oklch(root.lightness, self.value, root.hue);
                }
            }
            Text {
                width: 3rem;
                vertical-alignment: center;
                font-size: 0.875rem;
                color: UiState.theme.text-300;
                text: round(root.chroma * 1000) / 10;
            }
        }

        // hue
        HorizontalLayout {
            spacing: 0.75rem;
            Text {
                width: 5rem;
                vertical-alignment: center;
                text: "Hue";
                font-size: 0.875rem;
                color: UiState.theme.text-300;
            }
            Rectangle {
                height: 1.25rem;
                border-radius: 0.625rem;
                background: @linear-gradient(90deg, oklch(0.62, 0.2, 0deg), oklch(0.62, 0.2, 60deg), oklch(0.62, 0.2, 120deg), oklch(0.62, 0.2, 180deg), oklch(0.62, 0.2, 240deg), oklch(0.62, 0.2, 300deg), oklch(0.62, 0.2, 360deg));
                handle := Rectangle {
                    height: 1rem;
                    width: 1rem;
                    y: (parent.height - self.height) / 2;
                    x: clamp(root.hue / 360 * (parent.width - self.width), 0, parent.width - self.width);
                    border-radius: self.height / 2;
                    background: UiState.theme.background-50;
                    border-color: UiState.theme.background-100;
                    border-width: 1px;
                }
                TouchArea {
                    changed mouse-x => {
                        if self.has-hover || self.pressed {
                            root.color = oklch(root.lightness, root.chroma,
                                clamp((self.mouse-x / 1px - handle.width / 1px / 2) / max((parent.width - handle.width) / 1px, 1), 0, 1) * 360);
                        }
                    }
                }
            }
            Text {
                width: 3rem;
                vertical-alignment: center;
                font-size: 0.875rem;
                color: UiState.theme.text-300;
                text: round(root.hue) + "°";
            }
        }
    }
}

export component ThemeSettings inherits VerticalLayout {
    // which color field is expanded: 1 background, 2 text, 3 primary,
    // 4 secondary, 5 progress-red, 6 progress-yellow, 7 progress-green
    private property <int> expanded: -1;

    spacing: 1rem;
    alignment: start;

    HorizontalLayout {
        Text {
            text: "Base Colors";
            font-size: 1rem;
            color: UiState.theme.text-400;
        }
        Rectangle { horizontal-stretch: 1; }
        Button {
            text: "Reset";
            clicked => { Theme.reset(); }
        }
    }

    PalettePreview {
        palette: Theme.current;
    }

    ColorField {
        label: "Background";
        color <=> Theme.background;
        expanded: root.expanded == 1;
        toggle() => { root.expanded = root.expanded == 1 ? -1 : 1; }
    }

    ColorField {
        label: "Text";
        color <=> Theme.text;
        expanded: root.expanded == 2;
        toggle() => { root.expanded = root.expanded == 2 ? -1 : 2; }
    }

    ColorField {
        label: "Primary";
        color <=> Theme.primary;
        expanded: root.expanded == 3;
        toggle() => { root.expanded = root.expanded == 3 ? -1 : 3; }
    }

    ColorField {
        label: "Secondary";
        color <=> Theme.secondary;
        expanded: root.expanded == 4;
        toggle() => { root.expanded = root.expanded == 4 ? -1 : 4; }
    }

    Text {
        text: "Progress Points";
        font-size: 1rem;
        color: UiState.theme.text-400;
    }

    ColorField {
        label: "Red Point";
        color <=> Theme.progress-red;
        expanded: root.expanded == 5;
        toggle() => { root.expanded = root.expanded == 5 ? -1 : 5; }
    }

    ColorField {
        label: "Yellow Point";
        color <=> Theme.progress-yellow;
        expanded: root.expanded == 6;
        toggle() => { root.expanded = root.expanded == 6 ? -1 : 6; }
    }

    ColorField {
        label: "Green Point";
        color <=> Theme.progress-green;
        expanded: root.expanded == 7;
        toggle() => { root.expanded = root.expanded == 7 ? -1 : 7; }
    }
}
